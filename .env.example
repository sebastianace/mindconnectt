DB_URL=jdbc:mysql://localhost:3306/mindconnect
DB_USERNAME=mindconnect_user
DB_PASSWORD=change_me
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
QUEUE_BLOCK_USERS_FIXED_DELAY_MS=5000
# Clave para firmar los JWT: Base64, minimo 32 bytes. Generala con: openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_EXPIRATION_MS=3600000
# Opcional: primer administrador (se crea solo si el usuario no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_min_8_chars
